/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/bibleandconflictoftheages/*
  Cache-Control: public, max-age=0, must-revalidate

/chronbible/*
  Cache-Control: public, max-age=0, must-revalidate

# Development fixtures and app include fragments are not search landing pages.
/bibledecoded/*
  Cache-Control: private, no-store
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://embed.cloudflarestream.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://imgproxy.fourthwall.dev; connect-src 'self' https://erejehmrtzjpqurbftsm.supabase.co; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.cloudflarestream.com; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'

/bibledecoded/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/scripts/*
  X-Robots-Tag: noindex

/app/integration/*
  X-Robots-Tag: noindex

# Printed-guide offers are shared directly with selected recipients.
/guides
  X-Robots-Tag: noindex, noimageindex

/guides/*
  X-Robots-Tag: noindex, noimageindex
